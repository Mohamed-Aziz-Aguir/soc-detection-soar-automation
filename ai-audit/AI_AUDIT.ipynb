    "# Install required packages\n",
    "!pip install transformers\n",
    "!pip install torch\n",
    "!pip install PyMuPDF\n",
    "!pip install pillow\n",
    "\n",
    "# Import necessary libraries\n",
    "import os\n",
    "import fitz  # PyMuPDF\n",
    "from PIL import Image\n",
    "import torch\n",
    "from transformers import TrOCRProcessor, VisionEncoderDecoderModel\n",
    "\n",
    "# Directory setup\n",
    "PDF_DIR = \"/content/pdf\"\n",
    "OUTPUT_DIR = \"/content/output\"\n",
    "os.makedirs(OUTPUT_DIR, exist_ok=True)\n",
    "\n",
    "# Function to list all PDFs in the directory\n",
    "def get_pdf_files(directory):\n",
    "    return [f for f in os.listdir(directory) if f.lower().endswith('.pdf')]\n",
    "\n",
    "# Function to extract text using PyMuPDF (for digital PDFs)\n",
    "def extract_text_with_pymupdf(pdf_path):\n",
    "    try:\n",
    "        doc = fitz.open(pdf_path)\n",
    "        text = \"\"\n",
    "        for page in doc:\n",
    "            text += page.get_text()\n",
    "        doc.close()\n",
    "        return text.strip() if text.strip() else None\n",
    "    except Exception as e:\n",
    "        print(f\"PyMuPDF failed for {pdf_path}: {str(e)}\")\n",
    "        return None\n",
    "\n",
    "# Function to convert PDF page to image (for TrOCR)\n",
    "def pdf_page_to_image(pdf_path, page_num, zoom=2):\n",
    "    doc = fitz.open(pdf_path)\n",
    "    page = doc[page_num]\n",
    "    matrix = fitz.Matrix(zoom, zoom)  # Increase resolution\n",
    "    pix = page.get_pixmap(matrix=matrix)\n",
    "    img = Image.frombytes(\"RGB\", [pix.width, pix.height], pix.rgb)\n",
    "    doc.close()\n",
    "    return img\n",
    "\n",
    "# Function to extract text using TrOCR (for image-based PDFs)\n",
    "def extract_text_with_trocr(pdf_path):\n",
    "    processor = TrOCRProcessor.from_pretrained(\"microsoft/trocr-base-printed\")\n",
    "    model = VisionEncoderDecoderModel.from_pretrained(\"microsoft/trocr-base-printed\")\n",
    "    model.to(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "\n",
    "    doc = fitz.open(pdf_path)\n",
    "    text = \"\"\n",
    "    for page_num in range(len(doc)):\n",
    "        try:\n",
    "            image = pdf_page_to_image(pdf_path, page_num)\n",
    "            pixel_values = processor(image, return_tensors=\"pt\").pixel_values\n",
    "            pixel_values = pixel_values.to(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
    "            generated_ids = model.generate(pixel_values)\n",
    "            page_text = processor.batch_decode(generated_ids, skip_special_tokens=True)[0]\n",
    "            text += page_text + \"\\n\"\n",
    "        except Exception as e:\n",
    "            print(f\"TrOCR failed for page {page_num + 1} of {pdf_path}: {str(e)}\")\n",
    "    doc.close()\n",
    "    return text.strip() if text.strip() else None\n",
    "\n",
    "# Main function to process all PDFs\n",
    "def process_pdfs():\n",
    "    pdf_files = get_pdf_files(PDF_DIR)\n",
    "    if not pdf_files:\n",
    "        raise FileNotFoundError(f\"No PDFs found in {PDF_DIR}\")\n",
    "\n",
    "    print(f\"Found {len(pdf_files)} PDFs: {pdf_files}\")\n",
    "\n",
    "    for pdf_file in pdf_files:\n",
    "        pdf_path = os.path.join(PDF_DIR, pdf_file)\n",
    "        output_file = os.path.join(OUTPUT_DIR, f\"{os.path.splitext(pdf_file)[0]}_extracted.txt\")\n",
    "\n",
    "        print(f\"\\nProcessing {pdf_file}...\")\n",
    "\n",
    "        # Try PyMuPDF first (fast for digital PDFs)\n",
    "        text = extract_text_with_pymupdf(pdf_path)\n",
    "        if text:\n",
    "            print(f\"Extracted text with PyMuPDF for {pdf_file}\")\n",
    "        else:\n",
    "            # Fallback to TrOCR for image-based PDFs\n",
    "            print(f\"PyMuPDF failed, trying TrOCR for {pdf_file}\")\n",
    "            text = extract_text_with_trocr(pdf_path)\n",
    "\n",
    "        # Save extracted text\n",
    "        if text:\n",
    "            with open(output_file, \"w\") as f:\n",
    "                f.write(text)\n",
    "            print(f\"Saved extracted text to {output_file}\")\n",
    "            # Display preview (first 500 characters)\n",
    "            print(f\"Preview of extracted text (first 500 characters):\\n{text[:500]}\\n\")\n",
    "        else:\n",
    "            print(f\"Failed to extract text from {pdf_file}\")\n",
    "\n",
    "# Run the processing\n",
    "try:\n",
    "    process_pdfs()\n",
    "except Exception as e:\n",
    "    print(f\"An error occurred: {str(e)}\")"
   ]
  },
