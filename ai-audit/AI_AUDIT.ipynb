    "INPUT_FILE = \"/content/full_audit_report.txt\"\n",
    "LATEX_FILE = \"/content/full_audit_report.tex\"\n",
    "PDF_FILE = \"/content/full_audit_report.pdf\"\n",
    "\n",
    "# Check for input file\n",
    "if not os.path.exists(INPUT_FILE):\n",
    "    raise FileNotFoundError(f\"Input file {INPUT_FILE} not found\")\n",
    "\n",
    "# Escape LaTeX special characters\n",
    "def escape_latex(text):\n",
    "    replacements = {\n",
    "        '&': r'\\&',\n",
    "        '%': r'\\%',\n",
    "        '$': r'\\$',\n",
    "        '#': r'\\#',\n",
    "        '_': r'\\_',\n",
    "        '{': r'\\{',\n",
    "        '}': r'\\}',\n",
    "        '~': r'\\textasciitilde{}',\n",
    "        '^': r'\\^{}',\n",
    "        '\\\\': r'\\textbackslash{}',\n",
    "    }\n",
    "    pattern = re.compile('|'.join(re.escape(key) for key in replacements))\n",
    "    return pattern.sub(lambda match: replacements[match.group()], text)\n",
    "\n",
    "# Format text with LaTeX structure\n",
    "def format_for_latex(text):\n",
    "    formatted_lines = []\n",
    "    for line in text.splitlines():\n",
    "        line = line.strip()\n",
    "        if not line:\n",
    "            formatted_lines.append(r\"\\par\")  # Paragraph break\n",
    "            continue\n",
    "        if re.match(r\"^\\d+\\.\\s+\", line):  # Section titles like \"1. Findings\"\n",
    "            title = escape_latex(line)\n",
    "            formatted_lines.append(rf\"\\section*{{{title}}}\")\n",
    "        else:\n",
    "            formatted_lines.append(escape_latex(line) + r\"\\\\\")  # Line break\n",
    "    return '\\n'.join(formatted_lines)\n",
    "\n",
    "# Read and format content\n",
    "with open(INPUT_FILE, \"r\", encoding=\"utf-8\") as fin:\n",
    "    raw_content = fin.read()\n",
    "\n",
    "formatted_content = format_for_latex(raw_content)\n",
    "\n",
    "# Write LaTeX file\n",
    "with open(LATEX_FILE, \"w\", encoding=\"utf-8\") as f:\n",
    "    f.write(r\"\"\"\n",
    "\\documentclass[11pt, a4paper]{article}\n",
    "\\usepackage[utf8]{inputenc}\n",
    "\\usepackage[T1]{fontenc}\n",
    "\\usepackage{geometry}\n",
    "\\usepackage{hyperref}\n",
    "\\usepackage{xcolor}\n",
    "\\usepackage{fancyhdr}\n",
    "\\usepackage{lastpage}\n",
    "\\geometry{top=2.5cm, bottom=2.5cm, left=2cm, right=2cm}\n",
    "\\pagestyle{fancy}\n",
    "\\fancyhf{}\n",
    "\\fancyhead[L]{\\color{gray}\\small SOC Audit Report}\n",
    "\\fancyhead[R]{\\color{gray}\\small Banking Industry}\n",
    "\\fancyfoot[C]{\\color{gray}\\small Page \\thepage\\ of \\pageref{LastPage}}\n",
    "\\title{SOC Audit Report}\n",
    "\\author{Cybersecurity Audit Team}\n",
    "\\date{\\today}\n",
    "\\begin{document}\n",
    "\\maketitle\n",
    "\\tableofcontents\n",
    "\\newpage\n",
    "\"\"\")\n",
    "    f.write(formatted_content)\n",
    "    f.write(r\"\\end{document}\")\n",
    "\n",
    "# Compile LaTeX to PDF\n",
    "print(\"Compiling LaTeX to PDF...\")\n",
    "try:\n",
    "    result = subprocess.run(\n",
    "        [\"latexmk\", \"-pdf\", \"-interaction=nonstopmode\", LATEX_FILE],\n",
    "        cwd=\"/content\",\n",
    "        capture_output=True,\n",
    "        text=True\n",
    "    )\n",
    "    if result.returncode != 0:\n",
    "        print(f\"LaTeX compilation failed: {result.stderr}\")\n",
    "        raise RuntimeError(\"Failed to compile LaTeX to PDF\")\n",
    "    print(f\"PDF generated successfully at {PDF_FILE}\")\n",
    "except Exception as e:\n",
    "    print(f\"Error compiling PDF: {str(e)}\")\n",
    "    raise\n",
    "\n",
    "# Clean up auxiliary files\n",
    "for ext in [\"aux\", \"log\", \"out\", \"toc\", \"fls\", \"fdb_latexmk\"]:\n",
    "    file = f\"/content/full_audit_report.{ext}\"\n",
    "    if os.path.exists(file):\n",
    "        os.remove(file)\n",
    "\n",
    "# Download the PDF\n",
    "if os.path.exists(PDF_FILE):\n",
    "    print(\"Downloading PDF...\")\n",
    "    files.download(PDF_FILE)\n",
    "else:\n",
    "    print(f\"Error: PDF file {PDF_FILE} not found\")\n"
   ],
