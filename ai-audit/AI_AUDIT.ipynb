   "cell_type": "code",
   "source": [
    "from llama_cpp import Llama\n",
    "import uuid\n",
    "import random\n",
    "\n",
    "# Function to read .txt file with fallback encodings\n",
    "def read_txt_file(file_path):\n",
    "    encodings = [\"utf-8\", \"latin1\", \"iso-8859-1\", \"cp1252\"]\n",
    "    for encoding in encodings:\n",
    "        try:\n",
    "            with open(file_path, \"r\", encoding=encoding) as f:\n",
    "                return f.read().strip()\n",
    "        except UnicodeDecodeError:\n",
    "            continue\n",
    "        except Exception as e:\n",
    "            print(f\"Error reading {file_path}: {str(e)}\")\n",
    "            return None\n",
    "    print(f\"Failed to read {file_path}: All encodings failed\")\n",
    "    return None\n",
    "\n",
    "# File paths\n",
    "DOC_FILE = \"/content/doc_summaries.txt\"\n",
    "LOG_FILE = \"/content/log_summaries.txt\"\n",
    "\n",
    "# Read files\n",
    "documentation = read_txt_file(DOC_FILE)\n",
    "if documentation is None:\n",
    "    raise FileNotFoundError(f\"Could not read {DOC_FILE}\")\n",
    "\n",
    "logs_content = read_txt_file(LOG_FILE)\n",
    "if logs_content is None:\n",
    "    raise FileNotFoundError(f\"Could not read {LOG_FILE}\")\n",
    "\n",
    "logs = logs_content.split(\"\\n\")\n",
    "\n",
    "# Sample logs if too many, otherwise use all\n",
    "if len(logs) > 100:\n",
    "    logs_sampled = random.sample(logs, 100)  # Sample 100 random logs\n",
    "else:\n",
    "    logs_sampled = logs\n",
    "\n",
    "logs_combined = \"\\n\".join(logs_sampled)\n",
    "\n",
    "# Prepare the prompt\n",
    "prompt = f\"\"\"[INST]\n",
    "Analyze SOC documentation and logs to create a professional audit report focused on detection, response, configurations, automation, compliance, and maturity.\n",
    "\n",
    "Inputs:\n",
    "- Docs: SOC workflows, tools, networks, detection mechanisms, automation, and compliance documentation.\n",
    "- Logs: Real-world security logs with timestamps, actions, and errors.\n",
    "\n",
    "Tasks:\n",
    "1. Logs: Identify events, risks, detection gaps, and compliance issues (NIST 800-53).\n",
    "2. SOC: Analyze workflows, configurations, detection mechanisms, and automation; highlight strengths and weaknesses.\n",
    "3. Compliance: Verify logging effectiveness, vulnerability management, and identify compliance gaps (ISO 27001, NIST 800-53).\n",
