   "source": [
    "import os\n",
    "import pandas as pd\n",
    "\n",
    "# Alpaca prompt template\n",
    "alpaca_prompt = \"\"\"Below is an instruction that describes a task, paired with an input that provides further context. Write a response that appropriately completes the request.\n",
    "\n",
    "Instruction:\n",
    "{instruction}\n",
    "\n",
    "Input:\n",
    "{input}\n",
    "\n",
    "Response:\n",
    "{output}\"\"\"\n",
    "\n",
    "# Instruction for the model\n",
    "instruction = \"Provide a concise and clear summary of the provided document, capturing its main points and purpose.\"\n",
    "output = \"\"  # Leave blank for generation\n",
    "\n",
    "# Directory containing .txt files\n",
    "TXT_DIR = \"/content/output/\"\n",
    "\n",
    "# Function to read .txt file with fallback encodings\n",
    "def read_txt_file(file_path):\n",
    "    encodings = [\"utf-8\", \"latin1\", \"iso-8859-1\", \"cp1252\"]\n",
    "    for encoding in encodings:\n",
    "        try:\n",
    "            with open(file_path, \"r\", encoding=encoding) as f:\n",
    "                content = f.read().strip()\n",
    "            return content\n",
    "        except UnicodeDecodeError:\n",
    "            continue\n",
    "        except Exception as e:\n",
    "            print(f\"Error reading {file_path}: {str(e)}\")\n",
    "            return None\n",
    "    print(f\"Failed to read {file_path}: All encodings failed\")\n",
    "    return None\n",
    "\n",
    "# Extract and clean .txt file contents, limit to 10 for testing\n",
    "txt_contents = []\n",
    "if os.path.exists(TXT_DIR):\n",
    "    txt_files = [f for f in os.listdir(TXT_DIR) if f.endswith(\".txt\")][:10]  # Limit to 10 files\n",
    "    for filename in txt_files:\n",
    "        file_path = os.path.join(TXT_DIR, filename)\n",
    "        content = read_txt_file(file_path)\n",
    "        if content:  # Only include non-empty, successfully read files\n",
    "            txt_contents.append((filename, content))\n",
    "else:\n",
    "    print(f\"Directory {TXT_DIR} does not exist. Please create it and add .txt files.\")\n",
    "\n",
    "# List to store summaries\n",
    "summaries = []\n",
    "\n",
    "# Iterate through .txt file contents and generate responses\n",
    "for filename, content in txt_contents:\n",
    "    # Format the prompt with the current .txt content\n",
    "    prompt = alpaca_prompt.format(\n",
    "        instruction=instruction,\n",
    "        input=content,\n",
    "        output=output\n",
    "    )\n",
    "\n",
    "    # Generate the response\n",
    "    try:\n",
    "        response = llm(prompt, max_tokens=10000)  # Assuming llm is your model function\n",
    "        summary = response['choices'][0]['text']\n",
    "    except Exception as e:\n",
    "        print(f\"Error generating summary for {filename}: {str(e)}\")\n",
    "        continue\n",
    "\n",
    "    # Store the summary with filename for reference\n",
    "    summaries.append({\"filename\": filename, \"summary\": summary})\n",
    "\n",
    "    # Print the generated text\n",
    "    print(f\"Input File: {filename}\")\n",
    "    print(f\"Input Content (truncated): {content[:100]}...\")\n",
    "    print(f\"Generated Summary: {summary}\")\n",
    "    print(\"-\" * 50)\n",
    "\n",
    "# Make summaries available for the next cell\n",
    "if summaries:\n",
    "    print(\"Summaries stored in 'summaries' variable\")\n",
    "else:\n",
    "    print(\"No valid .txt files were processed. Check the /content/output/ directory and file encodings.\")"
   ],
