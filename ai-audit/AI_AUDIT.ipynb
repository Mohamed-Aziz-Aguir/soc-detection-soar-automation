    "import os\n",
    "import re\n",
    "import time\n",
    "import google.generativeai as genai\n",
    "\n",
    "# Path to the input and output files\n",
    "INPUT_FILE = \"/content/report_analysis.txt\"\n",
    "INPUT_FILE1 = \"/content/log_summaries.txt\"\n",
    "INPUT_FILE2 = \"/content/doc_summaries.txt\"\n",
    "OUTPUT_FILE = \"/content/full_audit_report.txt\"\n",
    "\n",
    "# Configure Gemini API (replace with your actual Gemini API key)\n",
    "GEMINI_API_KEY = \"AIzaSyAIFiJXPInGjNSzq4bTD-yCJho1Qqd0edo\"  # Replace with your Gemini API key\n",
    "genai.configure(api_key=GEMINI_API_KEY)\n",
    "\n",
    "# Function to read .txt file with fallback encodings\n",
    "def read_txt_file(file_path):\n",
    "    encodings = [\"utf-8\", \"latin1\", \"iso-8859-1\", \"cp1252\"]\n",
    "    for encoding in encodings:\n",
    "        try:\n",
    "            with open(file_path, \"r\", encoding=encoding) as f:\n",
    "                content = f.read().strip()\n",
    "            return content\n",
    "        except UnicodeDecodeError:\n",
    "            continue\n",
    "        except Exception as e:\n",
    "            print(f\"Error reading {file_path}: {str(e)}\")\n",
    "            return None\n",
    "    print(f\"Failed to read {file_path}: All encodings failed\")\n",
    "    return None\n",
    "\n",
    "# Clean input by removing problematic tags and handling truncation\n",
    "def clean_input(content):\n",
    "    # Remove <xaifArtifact> tag and its contents\n",
    "    content = re.sub(r'<xaifArtifact[^>]*>.*?</xaifArtifact>', '', content, flags=re.DOTALL)\n",
    "    # Handle truncated ending\n",
    "    if content.strip().endswith(\"The system has well-documented\"):\n",
    "        content += \" processes for threat detection and response, but lacks complete documentation for incident response automation.\"\n",
    "    return content.strip()\n",
    "\n",
    "# Read and clean the content of report_analysis.txt\n",
    "report_content = read_txt_file(INPUT_FILE)\n",
    "if report_content is None:\n",
    "    raise FileNotFoundError(f\"Could not read {INPUT_FILE}\")\n",
    "report_content = clean_input(report_content)\n",
    "\n",
    "report_content1 = read_txt_file(INPUT_FILE1)\n",
    "if report_content1 is None:\n",
    "    raise FileNotFoundError(f\"Could not read {INPUT_FILE1}\")\n",
    "report_content1 = clean_input(report_content1)\n",
    "\n",
    "report_content2 = read_txt_file(INPUT_FILE2)\n",
    "if report_content2 is None:\n",
    "    raise FileNotFoundError(f\"Could not read {INPUT_FILE2}\")\n",
    "report_content2 = clean_input(report_content2)\n",
    "\n",
    "# Define the prompt for Gemini\n",
    "prompt = f\"\"\"You are an expert cybersecurity auditor tasked with generating a detailed, professional, and well-structured audit report for a banking industry Cybersecurity Operations Center (SOC). The input is a preliminary SOC audit report detailing events, risks, detection gaps, compliance issues, and maturity levels. Your task is to produce a 1200-1500 word report that is comprehensive, banking-focused, and aligned with NIST 800-53 and C2M2 standards, using the input data explicitly.\n",
