    "rows = []\n",
    "\n",
    "def safe_flatten(obj):\n",
    "    \"\"\"Flatten nested JSON objects safely.\"\"\"\n",
    "    try:\n",
    "        if isinstance(obj, dict):\n",
    "            rows.append(json_normalize(obj).to_dict(orient=\"records\")[0])\n",
    "        elif isinstance(obj, list):\n",
    "            for item in obj:\n",
    "                if isinstance(item, dict):\n",
    "                    rows.append(json_normalize(item).to_dict(orient=\"records\")[0])\n",
    "    except Exception as e:\n",
    "        print(f\"⚠️ Skipping problematic entry: {e}\")\n",
    "\n",
    "# Flatten based on structure\n",
    "if isinstance(data, list):\n",
    "    for item in data:\n",
    "        safe_flatten(item)\n",
    "elif isinstance(data, dict):\n",
    "    for value in data.values():\n",
    "        safe_flatten(value)\n",
    "\n",
    "# Create DataFrame\n",
    "df = pd.DataFrame(rows)\n",
