    "# Select audit-relevant columns\n",
    "relevant_cols = [\n",
    "    'timestamp', 'id', 'agent.id', 'agent.name', 'rule.level', 'rule.description',\n",
    "    'rule.groups', 'rule.mitre.id', 'rule.mitre.tactic', 'rule.mitre.technique',\n",
    "    'rule.pci_dss', 'rule.nist_800_53', 'rule.tsc', 'data.audit.command',\n",
    "    'syscheck.path', 'predecoder.program_name', 'full_log', 'location'\n",
    "]\n",
    "df_clean = df[[col for col in relevant_cols if col in df.columns]].copy()\n",
    "\n",
    "# Convert lists to strings for specific columns\n",
    "list_cols = ['rule.groups', 'rule.pci_dss', 'rule.nist_800_53', 'rule.tsc',\n",
    "             'rule.mitre.id', 'rule.mitre.tactic', 'rule.mitre.technique']\n",
    "for col in list_cols:\n",
    "    if col in df_clean.columns:\n",
    "        df_clean[col] = df_clean[col].apply(lambda x: ','.join(map(str, x)) if isinstance(x, list) else x)\n",
    "\n",
    "# Convert data types\n",
    "df_clean['rule.level'] = pd.to_numeric(df_clean['rule.level'], errors='coerce')\n",
    "df_clean['timestamp'] = pd.to_datetime(df_clean['timestamp'], errors='coerce')\n",
    "\n",
    "# Handle missing values\n",
    "text_cols = [\n",
    "    'rule.description', 'rule.groups', 'data.audit.command', 'syscheck.path',\n",
    "    'predecoder.program_name', 'full_log', 'location', 'rule.pci_dss', 'rule.nist_800_53',\n",
    "    'rule.tsc', 'rule.mitre.id', 'rule.mitre.tactic', 'rule.mitre.technique'\n",
    "]\n",
    "for col in text_cols:\n",
    "    if col in df_clean.columns:\n",
    "        df_clean[col] = df_clean[col].fillna('unknown').astype(str)\n",
    "\n",
    "for col in ['agent.id', 'agent.name']:\n",
    "    if col in df_clean.columns:\n",
    "        df_clean[col] = df_clean[col].fillna('unknown')\n",
    "\n",
    "# Sample dropped rows with missing critical fields\n",
    "original_rows = len(df_clean)\n",
    "# Relax rule.level filter: retain rows with specific keywords in full_log or location\n",
    "keep_keywords = ['rootcheck', 'ossec', 'scan', 'sca']\n",
    "dropped_mask = (df_clean['rule.level'].isna() | df_clean['timestamp'].isna()) & \\\n",
    "               (~df_clean['full_log'].str.contains('|'.join(keep_keywords), case=False, na=False)) & \\\n",
    "               (~df_clean['location'].str.contains('|'.join(keep_keywords), case=False, na=False))\n",
    "if dropped_mask.any():\n",
    "    print(\"\\n📋 Sample of Dropped Rows (Missing 'rule.level' or 'timestamp', up to 3):\")\n",
    "    dropped_samples = df_clean[dropped_mask][relevant_cols].head(3)\n",
    "    print(dropped_samples)\n",
    "    # Save dropped rows for inspection\n",
    "    df_clean[dropped_mask][relevant_cols].to_csv(\"/content/dropped_rows.csv\", index=False)\n",
    "    print(\"📉 Saved dropped rows to 'dropped_rows.csv'\")\n",
    "\n",
    "# Sample and count retained keyword logs\n",
    "retained_mask = (df_clean['rule.level'].isna() | df_clean['timestamp'].isna()) & \\\n",
    "                (df_clean['full_log'].str.contains('|'.join(keep_keywords), case=False, na=False) | \\\n",
    "                 df_clean['location'].str.contains('|'.join(keep_keywords), case=False, na=False))\n",
    "if retained_mask.any():\n",
    "    print(\"\\n📋 Sample of Retained Keyword Logs (up to 3):\")\n",
    "    retained_samples = df_clean[retained_mask][relevant_cols].head(3)\n",
    "    print(retained_samples)\n",
    "    # Count retained rows per keyword\n",
    "    print(\"\\n📊 Retained Keyword Counts:\")\n",
    "    for keyword in keep_keywords:\n",
    "        count = df_clean[retained_mask]['full_log'].str.contains(keyword, case=False, na=False).sum() + \\\n",
    "                df_clean[retained_mask]['location'].str.contains(keyword, case=False, na=False).sum()\n",
    "        print(f\"{keyword}: {count} rows\")\n",
    "\n",
    "# Remove rows based on relaxed filter\n",
    "df_clean = df_clean[~dropped_mask]\n",
    "dropped_critical = original_rows - len(df_clean)\n",
    "print(f\"📉 Dropped {dropped_critical} rows with missing 'rule.level' or 'timestamp' (excluding rootcheck/ossec/scan/sca logs)\")\n",
    "\n",
    "# Impute missing rule.level with 0 (informational)\n",
    "df_clean.loc[:, 'rule.level'] = df_clean['rule.level'].fillna(0).astype(int)\n",
    "\n",
    "# Filter out uninformative logs (all text fields are 'unknown')\n",
    "text_cols_present = [col for col in text_cols if col in df_clean.columns]\n",
    "uninformative_mask = (df_clean[text_cols_present] == 'unknown').all(axis=1)\n",
    "dropped_uninformative = uninformative_mask.sum()\n",
    "print(f\"📉 Dropped {dropped_uninformative} uninformative rows (all text fields 'unknown')\")\n",
    "\n",
    "# Sample uninformative logs for inspection\n",
    "if dropped_uninformative > 0:\n",
    "    print(\"\\n📋 Sample of Dropped Uninformative Logs (up to 3):\")\n",
    "    uninformative_samples = df_clean[uninformative_mask][text_cols_present].head(3)\n",
    "    print(uninformative_samples)\n",
    "\n",
    "# Apply filter\n",
    "df_clean = df_clean[~uninformative_mask]\n",
    "\n",
    "# Preprocess full_log to reduce noise\n",
    "def clean_full_log(row):\n",
    "    full_log = row['full_log'].lower()\n",
    "    # Remove Wazuh prefixes\n",
    "    prefixes = ['ossec:', 'wazuh:']\n",
    "    for prefix in prefixes:\n",
    "        full_log = full_log.replace(prefix, '').strip()\n",
    "    # Remove redundant fields\n",
    "    for field in ['timestamp', 'rule.description', 'agent.name', 'location']:\n",
    "        if field in row and isinstance(row[field], str):\n",
    "            full_log = full_log.replace(row[field].lower(), '').strip()\n",
    "    # Remove journald timestamps (e.g., \"Feb 13 14:28:30\")\n",
    "    import re\n",
    "    full_log = re.sub(r'^\\w{3}\\s+\\d{1,2}\\s+\\d{2}:\\d{2}:\\d{2}\\s+\\S+\\s+', '', full_log)\n",
    "    # Simplify program names (e.g., \"gnome-shell[2695]\" -> \"gnome-shell\")\n",
    "    full_log = re.sub(r'(\\S+)\\[\\d+\\]', r'\\1', full_log)\n",
    "    # Handle disk usage logs (limit to one per agent)\n",
    "    if \"'df -P'\" in full_log:\n",
    "        full_log = 'disk usage check'\n",
    "    # Parse SCA JSON\n",
    "    if full_log.startswith('{\"type\":\"policies\"'):\n",
    "        try:\n",
    "            import json\n",
    "            data = json.loads(full_log)\n",
    "            policies = data.get('policies', [])\n",
    "            full_log = f\"sca policies: {', '.join(policies)}\"\n",
    "        except:\n",
    "            full_log = 'sca policy check'\n",
    "    # Remove extra whitespace\n",
    "    full_log = ' '.join(full_log.split())\n",
    "    return full_log if full_log else 'unknown'\n",
    "\n",
    "df_clean.loc[:, 'full_log'] = df_clean.apply(clean_full_log, axis=1)\n",
    "\n",
    "# Limit disk usage logs to one per agent\n",
    "disk_usage_mask = df_clean['full_log'] == 'disk usage check'\n",
    "if disk_usage_mask.any():\n",
    "    df_clean = df_clean.groupby('agent.name').apply(lambda x: x[disk_usage_mask].head(1) if x[disk_usage_mask].any() else x).reset_index(drop=True)\n",
    "\n",
    "# Standardize text and fix common typos\n",
    "for col in text_cols_present:\n",
    "    df_clean.loc[:, col] = (df_clean[col]\n",
    "                            .str.lower()\n",
    "                            .str.strip()\n",
    "                            .str.replace('sensetive', 'sensitive')\n",
    "                            .str.replace('dkgp', 'dpkg')\n",
    "                            .str.replace(r'debian package|dpkg', 'dpkg', regex=True))\n",
    "\n",
    "# Integrity check\n",
    "print(\"\\n📊 Column Integrity Check:\")\n",
    "for col in df_clean.columns:\n",
    "    non_null_rate = (df_clean[col].notna().sum() / len(df_clean)) * 100\n",
    "    try:\n",
    "        unique_count = df_clean[col].nunique()\n",
    "    except Exception as e:\n",
    "        unique_count = f'N/A (Error: {str(e)})'\n",
    "    print(f\"{col}: Non-Null Rate = {non_null_rate:.2f}%, Unique Values = {unique_count}\")\n",
    "\n",
    "# Save cleaned DataFrame\n",
    "df_clean.to_csv(\"/content/wazuh_logs_clean.csv\", index=False)\n",
    "print(\"✅ Saved cleaned DataFrame to 'wazuh_logs_clean.csv'\")\n",
    "\n",
    "# Summary\n",
    "print(f\"\\n📊 Cleaned DataFrame: {len(df_clean)} rows, {len(df_clean.columns)} columns\")\n",
    "print(\"Missing values:\\n\", df_clean.isna().sum())\n",
    "\n",
    "# Sample full_log for verification\n",
    "print(\"\\n📋 Sample of Processed full_log (up to 5):\")\n",
    "print(df_clean['full_log'].head(5))"
